---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Emmanuel Guilherme Jr.',
  url: 'https://github.com/emmanuelgjr',
  sameAs: ['https://www.linkedin.com/in/emmanuelgjr/', 'https://genai.owasp.org/'],
  jobTitle: 'Senior Global IT Auditor',
};
---

<BaseLayout
  title="About — AI Governance Toolkit"
  description="About the author. Candidate Expert on Canada's ISO/IEC SC 42 mirror committee."
  structuredData={structuredData}
>
  <section class="max-w-3xl mx-auto px-6 lg:px-8 py-12">
    <p class="text-sm font-medium text-accent-700">About</p>
    <h1 class="font-display font-semibold text-3xl md:text-4xl tracking-tight text-ink-900 mt-2">About the author</h1>

    <div class="prose prose-lg max-w-prose-wide mt-8">
      <p>
        <strong>Emmanuel Guilherme Jr.</strong> is a Senior Global Information
        Technology Auditor and AI security researcher based in Toronto, Canada.
      </p>
      <p>
        He co-leads the Data Security Initiative of the <strong>OWASP GenAI
        Security Project</strong>. He serves as a <strong>Candidate Expert</strong>
        on Canada's mirror committee for <strong>ISO/IEC JTC 1/SC 42</strong> —
        the body that shapes ISO/IEC 42001 (AI management systems), 23894 (AI
        risk management), and 42005 (AI system impact assessment).
      </p>
      <p>
        He co-founded the Toronto chapter of Threat Modeling Connect and is a
        technical reviewer for Packt publications on AI security. His
        professional work spans IT audit at a Tier 1 multinational, an
        in-house Red Team build at a Canadian Schedule I bank, and AI
        security research at McMaster University.
      </p>
      <p>
        Find him at <a href="https://www.linkedin.com/in/emmanuelgjr/">LinkedIn</a> ·
        <a href="https://github.com/emmanuelgjr">GitHub</a>.
      </p>
      <h2>Citation</h2>
      <p class="font-mono text-sm">Guilherme Jr., E. (2026). AI Governance Toolkit (Version 0.1.0). https://aigovernancetoolkit.dev</p>
    </div>
  </section>
</BaseLayout>
