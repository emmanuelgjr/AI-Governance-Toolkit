---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataManager from '../components/DataManager.tsx';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Manage your data — AI Governance Toolkit"
  description="Export, import, or clear all toolkit data stored in your browser."
>
  <section class="max-w-3xl mx-auto px-6 lg:px-8 py-12">
    <p class="text-sm font-medium text-accent-700">Data</p>
    <h1 class="font-display font-semibold text-3xl md:text-4xl tracking-tight text-ink-900 mt-2">Manage your data</h1>
    <p class="mt-3 text-ink-600 max-w-prose-wide">
      Export to JSON, import from a backup, or clear everything from this
      browser. Read about the privacy design on the <a href={`${base}privacy`} class="text-accent-700 hover:underline">Privacy page</a>.
    </p>
    <div class="mt-10">
      <DataManager client:only="react" />
    </div>
  </section>
</BaseLayout>
