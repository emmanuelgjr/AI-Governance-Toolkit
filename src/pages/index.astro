---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="AI Governance Toolkit — Stand up AI governance in your organization. By Friday."
  description="Day-one operating kit for an AI governance program. ISO/IEC 42001-aligned templates, interactive AI System Inventory, AIIA per ISO/IEC 42005, risk register. Your data stays in your browser."
>
  <section class="max-w-content mx-auto px-6 lg:px-8 pt-16 pb-12">
    <p class="text-sm font-medium text-accent-700">Govern AI</p>
    <h1 class="font-display font-semibold tracking-tight text-4xl md:text-5xl text-ink-900 mt-3 max-w-3xl">
      Stand up AI governance in your organization. By Friday.
    </h1>
    <p class="mt-5 text-lg text-ink-600 leading-relaxed max-w-3xl">
      The day-one operating kit for an AI governance program. Interactive AI
      System Inventory, AI Impact Assessment per ISO/IEC 42005, AI Risk
      Register, ISO/IEC 42001 roadmap, and downloadable templates. All open.
      All free. <strong>All your data stays in your browser.</strong>
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`${base}inventory`} class="btn btn-primary btn-lg">Start your AI inventory →</a>
      <a href={`${base}aiia`} class="btn btn-secondary btn-lg">Run an AIIA</a>
    </div>
    <p class="mt-5 inline-flex items-center gap-2 text-xs text-ok-700 bg-ok-50 px-3 py-1.5 rounded-full">
      🔒 No backend. No accounts. No telemetry on your data.
    </p>
  </section>

  <section class="max-w-content mx-auto px-6 lg:px-8 py-12 border-t border-ink-100">
    <h2 class="font-display font-semibold text-3xl text-ink-900 tracking-tight">What's inside</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      <a href={`${base}inventory`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">🗂️ AI System Inventory</h3>
        <p class="mt-2 text-sm text-ink-600">Register, classify, and govern. Auto-suggests EU AI Act risk tier.</p>
      </a>
      <a href={`${base}aiia`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">📋 AI Impact Assessment</h3>
        <p class="mt-2 text-sm text-ink-600">10-section assessment per ISO/IEC 42005. Word doc export.</p>
      </a>
      <a href={`${base}risk-register`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">🎯 AI Risk Register</h3>
        <p class="mt-2 text-sm text-ink-600">Inherent / residual scoring, heatmap, Excel export.</p>
      </a>
      <a href={`${base}iso-42001-roadmap`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">🗺️ ISO/IEC 42001 Roadmap</h3>
        <p class="mt-2 text-sm text-ink-600">Phase-by-phase implementation guide.</p>
      </a>
      <a href={`${base}templates`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">📄 Templates</h3>
        <p class="mt-2 text-sm text-ink-600">Charter, AUP, intake, model card, board deck.</p>
      </a>
      <a href={`${base}privacy`} class="card hover:shadow-lift transition">
        <h3 class="text-lg font-semibold text-ink-900">🔒 Privacy by design</h3>
        <p class="mt-2 text-sm text-ink-600">All your data stays in your browser. Read why.</p>
      </a>
    </div>
  </section>

  <section class="max-w-content mx-auto px-6 lg:px-8 py-12 border-t border-ink-100">
    <div class="max-w-prose-wide">
      <h2 class="font-display font-semibold text-3xl text-ink-900 tracking-tight">Standards-author credibility</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Built by a <strong>Candidate Expert on Canada's ISO/IEC JTC 1/SC 42
        mirror committee</strong> — the body that shapes ISO/IEC 42001, 23894,
        and 42005. No commercial vendor or consultancy can match the
        standards-body provenance of this toolkit.
      </p>
      <a href={`${base}about`} class="inline-block mt-4 text-accent-700 font-medium hover:text-accent-800">About the author →</a>
    </div>
  </section>
</BaseLayout>
