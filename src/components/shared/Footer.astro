  <div class="max-w-content mx-auto px-6 lg:px-8 py-8 text-sm text-ink-600 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <p>© {year} Emmanuel Guilherme Jr. · Code MIT · Content CC-BY 4.0 · <a class="text-accent-700 hover:underline" href={`${base}privacy`}>Privacy</a></p>
    <p>
      Portfolio:
      <a class="hover:text-accent-700" href="https://aicontrolscatalog.dev">Controls</a> ·
      <a class="hover:text-accent-700" href="https://airedteam.dev">Red Team</a> ·
      <a class="hover:text-accent-700" href="https://shadowaidefense.dev">Shadow AI Defense</a>
    </p>
  </div>
</footer>
